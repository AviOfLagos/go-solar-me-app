# API (public). solar.nexprove.com is live; solar-ng.vercel.app also works.
EXPO_PUBLIC_API_BASE=https://solar.nexprove.com/api/v1

# Google sign-in (public client IDs, not secrets)
# Web client: the server already accepts it; Android sign-in uses it as webClientId.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=30374421318-qf53knqbj1q4kddvu1upp5fokub2hnpr.apps.googleusercontent.com
# iOS client: from Google Cloud project solar-builders-ng. Also put its reversed form in app.json (google-signin iosUrlScheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
